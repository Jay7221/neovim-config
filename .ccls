# CCLS Configuration for Competitive Programming
# Use g++-15 as the compiler
%c /opt/homebrew/bin/g++-15
%cpp /opt/homebrew/bin/g++-15

# Compiler flags for competitive programming
-std=c++20
-Wall
-Wextra
-O2

# Suppress common competitive programming warnings
-Wno-unused-variable
-Wno-unused-parameter
-Wno-sign-compare
-Wno-unused-but-set-variable

-I/opt/homebrew/Cellar/gcc/15.1.0/bin/../lib/gcc/current/gcc/aarch64-apple-darwin23/15/../../../../../../include/c++/15
-I/opt/homebrew/Cellar/gcc/15.1.0/bin/../lib/gcc/current/gcc/aarch64-apple-darwin23/15/../../../../../../include/c++/15/aarch64-apple-darwin23
-I/opt/homebrew/Cellar/gcc/15.1.0/bin/../lib/gcc/current/gcc/aarch64-apple-darwin23/15/../../../../../../include/c++/15/backward
-I/opt/homebrew/Cellar/gcc/15.1.0/bin/../lib/gcc/current/gcc/aarch64-apple-darwin23/15/include
-I/opt/homebrew/Cellar/gcc/15.1.0/bin/../lib/gcc/current/gcc/aarch64-apple-darwin23/15/include-fixed
